<?xml version="1.0" encoding="utf-8"?>
<package name="Демо">
  <rounds>
    <round name="Разминка">
      <themes>
        <theme name="Текст">
          <questions>
            <question price="100">
              <params><param name="question" type="content"><item>Как звали первого римского императора?</item></param></params>
              <right><answer>Октавиан Август</answer><answer>Август</answer></right>
            </question>
            <question price="200">
              <params><param name="question" type="content"><item>В этом длинном вопросе ведущая читает несколько фраз подряд, и полоска ответа может пойти, пока она ещё не договорила. Какой газ человек вдыхает при дыхании? Слушайте спокойно: кнопка откроется раньше, чем чтение закончится, если фраза не уложится в несколько секунд.</item></param></params>
              <right><answer>кислород</answer></right>
            </question>
          </questions>
        </theme>
        <theme name="Выбор">
          <questions>
            <question price="100">
              <params>
                <param name="question" type="content"><item>Что появилось раньше?</item></param>
                <param name="answerType">select</param>
                <param name="answerOptions" type="group">
                  <param name="A" type="content"><item>Индиана Джонс</item></param>
                  <param name="B" type="content"><item>Назад в будущее</item></param>
                  <param name="C" type="content"><item>Терминатор</item></param>
                  <param name="D" type="content"><item>Звёздные войны</item></param>
                </param>
              </params>
              <right><answer>D</answer></right>
            </question>
          </questions>
        </theme>
        <theme name="Космос">
          <questions>
            <question price="100">
              <params><param name="question" type="content"><item>Кто был вторым человеком в космосе?</item></param></params>
              <right><answer>Герман Титов</answer></right>
            </question>
          </questions>
        </theme>
      </themes>
    </round>
    <round name="Наглядно">
      <themes>
        <theme name="Картинка">
          <questions>
            <question price="100">
              <params>
                <param name="question" type="content">
                  <item type="image" isRef="true">demo/circle.svg</item>
                  <item>Какого цвета круг на картинке?</item>
                </param>
              </params>
              <right><answer>красный</answer></right>
            </question>
          </questions>
        </theme>
        <theme name="Музыка">
          <questions>
            <question price="100">
              <params>
                <param name="question" type="content">
                  <item type="audio" isRef="true">demo/beeps.wav</item>
                  <item>Сколько отдельных сигналов вы услышали?</item>
                </param>
              </params>
              <right><answer>3</answer><answer>три</answer></right>
            </question>
          </questions>
        </theme>
        <theme name="Ролик">
          <questions>
            <question price="100">
              <params>
                <param name="question" type="content">
                  <item type="video" isRef="true">demo/square.mp4</item>
                  <item>Какая фигура показана в ролике?</item>
                </param>
              </params>
              <right><answer>квадрат</answer></right>
            </question>
          </questions>
        </theme>
        <theme name="Без слов">
          <questions>
            <question price="100">
              <params>
                <param name="question" type="content">
                  <item type="image" isRef="true">demo/circle.svg</item>
                </param>
              </params>
              <right><answer>красный</answer></right>
            </question>
          </questions>
        </theme>
        <theme name="Показ">
          <questions>
            <question price="100">
              <params>
                <param name="question" type="content">
                  <item>Что ставят на документ, чтобы заверить его?</item>
                  <item type="marker"></item>
                  <item type="image" isRef="true">demo/seal.svg</item>
                </param>
              </params>
              <right><answer>печать</answer></right>
            </question>
          </questions>
        </theme>
        <theme name="Стопка">
          <questions>
            <question price="100">
              <params><param name="question" type="content"><item>Первый вопрос стопки?</item></param></params>
              <right><answer>первый</answer></right>
            </question>
            <question price="100">
              <params><param name="question" type="content"><item>Второй вопрос стопки?</item></param></params>
              <right><answer>второй</answer></right>
            </question>
          </questions>
        </theme>
      </themes>
    </round>
    <round name="Особые">
      <themes>
        <theme name="Сюрприз">
          <questions>
            <question price="100">
              <params><param name="question" type="content"><item>Сколько ног у паука?</item></param></params>
              <right><answer>восемь</answer><answer>8</answer></right>
            </question>
            <question price="200">
              <type name="cat"><param name="theme">Животные</param><param name="cost">0</param></type>
              <params><param name="question" type="content"><item>Какое животное самое быстрое на суше?</item></param></params>
              <right><answer>гепард</answer></right>
            </question>
            <question price="300">
              <type name="bagcat"><param name="theme">Города</param><param name="cost">[100;300]/200</param><param name="knows">before</param><param name="self">false</param></type>
              <params><param name="question" type="content"><item>Какой город называют Северной столицей России?</item></param></params>
              <right><answer>Санкт-Петербург</answer><answer>Петербург</answer><answer>Питер</answer></right>
            </question>
          </questions>
        </theme>
        <theme name="Торги">
          <questions>
            <question price="100">
              <params><param name="question" type="content"><item>Сколько дней в високосном году?</item></param></params>
              <right><answer>366</answer></right>
            </question>
            <question price="200" type="auction">
              <params><param name="question" type="content"><item>Какой город — столица Австралии?</item></param></params>
              <right><answer>Канберра</answer></right>
            </question>
            <question price="300">
              <params><param name="question" type="content"><item>Сколько планет в Солнечной системе?</item></param></params>
              <right><answer>восемь</answer><answer>8</answer></right>
            </question>
          </questions>
        </theme>
      </themes>
    </round>
  </rounds>
</package>
